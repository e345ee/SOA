{
  "TicketType": {
    "type": "string",
    "nullable": true,
    "enum": [
      "VIP",
      "USUAL",
      "CHEAP"
    ]
  },
  "Coordinates": {
    "type": "object",
    "required": [
      "x"
    ],
    "properties": {
      "x": {
        "type": "number",
        "format": "double",
        "minimum": -495,
        "exclusiveMinimum": true
      },
      "y": {
        "type": "integer",
        "format": "int32",
        "minimum": -262
      }
    }
  },
  "Location": {
    "type": "object",
    "required": [
      "x",
      "y",
      "name"
    ],
    "properties": {
      "x": {
        "type": "integer",
        "format": "int32"
      },
      "y": {
        "type": "integer",
        "format": "int32"
      },
      "name": {
        "type": "string"
      }
    }
  },
  "Person": {
    "type": "object",
    "required": [
      "birthday",
      "location"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "birthday": {
        "type": "string",
        "format": "date"
      },
      "weight": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "location": {
        "$ref": "#/components/schemas/Location"
      }
    }
  },
  "PersonCreate": {
    "type": "object",
    "required": [
      "birthday",
      "location"
    ],
    "properties": {
      "birthday": {
        "type": "string",
        "format": "date"
      },
      "weight": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "location": {
        "$ref": "#/components/schemas/Location"
      }
    }
  },
  "Ticket": {
    "type": "object",
    "required": [
      "id",
      "name",
      "coordinates",
      "creationDate",
      "price",
      "person",
      "eventId"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "readOnly": true
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "coordinates": {
        "$ref": "#/components/schemas/Coordinates"
      },
      "creationDate": {
        "type": "string",
        "format": "date-time",
        "readOnly": true
      },
      "price": {
        "type": "number",
        "format": "float",
        "minimum": 0,
        "exclusiveMinimum": true
      },
      "type": {
        "$ref": "#/components/schemas/TicketType"
      },
      "person": {
        "$ref": "#/components/schemas/Person"
      },
      "eventId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      }
    }
  },
  "TicketCreate": {
    "type": "object",
    "required": [
      "name",
      "coordinates",
      "price",
      "eventId"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "readOnly": true
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "coordinates": {
        "$ref": "#/components/schemas/Coordinates"
      },
      "creationDate": {
        "type": "string",
        "format": "date",
        "readOnly": true
      },
      "price": {
        "type": "number",
        "format": "float",
        "minimum": 0,
        "exclusiveMinimum": true
      },
      "type": {
        "$ref": "#/components/schemas/TicketType"
      },
      "personId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "person": {
        "$ref": "#/components/schemas/Person"
      },
      "eventId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      }
    },
    "oneOf": [
      {
        "required": [
          "personId"
        ]
      },
      {
        "required": [
          "person"
        ]
      }
    ]
  },
  "TicketPageResponse": {
    "type": "object",
    "properties": {
      "content": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Ticket"
        }
      },
      "page": {
        "type": "integer",
        "minimum": 0
      },
      "size": {
        "type": "integer",
        "minimum": 1
      },
      "totalElements": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      },
      "totalPages": {
        "type": "integer",
        "minimum": 0
      },
      "hasNext": {
        "type": "boolean"
      },
      "hasPrevious": {
        "type": "boolean"
      }
    }
  },
  "PersonPageResponse": {
    "type": "object",
    "properties": {
      "content": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Person"
        }
      },
      "page": {
        "type": "integer",
        "minimum": 0
      },
      "size": {
        "type": "integer",
        "minimum": 1
      },
      "totalElements": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      },
      "totalPages": {
        "type": "integer",
        "minimum": 0
      },
      "hasNext": {
        "type": "boolean"
      },
      "hasPrevious": {
        "type": "boolean"
      }
    }
  },
  "TicketSearchRequest": {
    "type": "object",
    "properties": {
      "filter": {
        "$ref": "#/components/schemas/TicketSearchFilter"
      },
      "page": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "sort": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/TicketSort"
        }
      }
    }
  },
  "TicketSearchFilter": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "nameContains": {
        "type": "string",
        "minLength": 1,
        "description": "Частичное совпадение name"
      },
      "coordinatesXFrom": {
        "type": "number",
        "format": "double",
        "minimum": -495,
        "exclusiveMinimum": true
      },
      "coordinatesXTo": {
        "type": "number",
        "format": "double"
      },
      "coordinatesYFrom": {
        "type": "integer",
        "format": "int32",
        "minimum": -262
      },
      "coordinatesYTo": {
        "type": "integer",
        "format": "int32"
      },
      "creationDateFrom": {
        "type": "string",
        "format": "date-time"
      },
      "creationDateTo": {
        "type": "string",
        "format": "date-time"
      },
      "priceFrom": {
        "type": "number",
        "format": "float",
        "minimum": 0,
        "exclusiveMinimum": true
      },
      "priceTo": {
        "type": "number",
        "format": "float",
        "minimum": 0,
        "exclusiveMinimum": true
      },
      "type": {
        "$ref": "#/components/schemas/TicketType"
      },
      "personBirthday": {
        "type": "string",
        "format": "date"
      },
      "personBirthdayFrom": {
        "type": "string",
        "format": "date"
      },
      "personBirthdayTo": {
        "type": "string",
        "format": "date"
      },
      "personWeight": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "personWeightFrom": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "personWeightTo": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "personLocationX": {
        "type": "integer",
        "format": "int32"
      },
      "personLocationY": {
        "type": "integer",
        "format": "int32"
      },
      "personLocationNameContains": {
        "type": "string",
        "description": "Частичное совпадение person.location.name"
      },
      "eventId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      }
    }
  },
  "TicketSort": {
    "type": "object",
    "required": [
      "field",
      "direction"
    ],
    "properties": {
      "field": {
        "type": "string",
        "enum": [
          "id",
          "name",
          "coordinates.x",
          "coordinates.y",
          "creationDate",
          "price",
          "type",
          "person.birthday",
          "person.weight",
          "person.location.x",
          "person.location.y",
          "person.location.name",
          "eventId"
        ]
      },
      "direction": {
        "type": "string",
        "enum": [
          "ASC",
          "DESC"
        ]
      }
    }
  },
  "PersonSearchRequest": {
    "type": "object",
    "properties": {
      "filter": {
        "$ref": "#/components/schemas/PersonSearchFilter"
      },
      "page": {
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "sort": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/PersonSort"
        }
      }
    }
  },
  "PersonSearchFilter": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "birthday": {
        "type": "string",
        "format": "date"
      },
      "birthdayFrom": {
        "type": "string",
        "format": "date"
      },
      "birthdayTo": {
        "type": "string",
        "format": "date"
      },
      "weight": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "weightFrom": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "weightTo": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "locationX": {
        "type": "integer",
        "format": "int32"
      },
      "locationY": {
        "type": "integer",
        "format": "int32"
      },
      "locationNameContains": {
        "type": "string",
        "description": "Частичное совпадение location.name"
      }
    }
  },
  "PersonSort": {
    "type": "object",
    "required": [
      "field",
      "direction"
    ],
    "properties": {
      "field": {
        "type": "string",
        "enum": [
          "id",
          "birthday",
          "weight",
          "location.x",
          "location.y",
          "location.name"
        ]
      },
      "direction": {
        "type": "string",
        "enum": [
          "ASC",
          "DESC"
        ]
      }
    }
  },
  "ErrorResponse": {
    "type": "object",
    "required": [
      "title",
      "status",
      "detail"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      },
      "detail": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "TicketType": {
    "type": "string",
    "nullable": true,
    "enum": [
      "VIP",
      "USUAL",
      "CHEAP"
    ]
  },
  "Coordinates": {
    "type": "object",
    "required": [
      "x"
    ],
    "properties": {
      "x": {
        "type": "number",
        "format": "double",
        "minimum": -495,
        "exclusiveMinimum": true
      },
      "y": {
        "type": "integer",
        "format": "int32",
        "minimum": -262
      }
    }
  },
  "Location": {
    "type": "object",
    "required": [
      "x",
      "y",
      "name"
    ],
    "properties": {
      "x": {
        "type": "integer",
        "format": "int32"
      },
      "y": {
        "type": "integer",
        "format": "int32"
      },
      "name": {
        "type": "string"
      }
    }
  },
  "Person": {
    "type": "object",
    "required": [
      "birthday",
      "location"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "birthday": {
        "type": "string",
        "format": "date"
      },
      "weight": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "location": {
        "$ref": "#/components/schemas/Location"
      }
    }
  },
  "PersonCreate": {
    "type": "object",
    "required": [
      "birthday",
      "location"
    ],
    "properties": {
      "birthday": {
        "type": "string",
        "format": "date"
      },
      "weight": {
        "type": "integer",
        "format": "int32",
        "minimum": 1
      },
      "location": {
        "$ref": "#/components/schemas/Location"
      }
    }
  },
  "Ticket": {
    "type": "object",
    "required": [
      "id",
      "name",
      "coordinates",
      "creationDate",
      "price",
      "person",
      "eventId"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "readOnly": true
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "coordinates": {
        "$ref": "#/components/schemas/Coordinates"
      },
      "creationDate": {
        "type": "string",
        "format": "date-time",
        "readOnly": true
      },
      "price": {
        "type": "number",
        "format": "float",
        "minimum": 1,
        "description": "Итоговая цена проданного билета в рублях; не ниже 1 рубля."
      },
      "type": {
        "$ref": "#/components/schemas/TicketType"
      },
      "person": {
        "$ref": "#/components/schemas/Person"
      },
      "eventId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      }
    }
  },
  "TicketCreate": {
    "type": "object",
    "required": [
      "name",
      "coordinates",
      "price",
      "eventId"
    ],
    "properties": {
      "id": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "readOnly": true
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "coordinates": {
        "$ref": "#/components/schemas/Coordinates"
      },
      "creationDate": {
        "type": "string",
        "format": "date",
        "readOnly": true
      },
      "price": {
        "type": "number",
        "format": "float",
        "minimum": 0,
        "exclusiveMinimum": true
      },
      "type": {
        "$ref": "#/components/schemas/TicketType"
      },
      "personId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      },
      "person": {
        "$ref": "#/components/schemas/Person"
      },
      "eventId": {
        "type": "integer",
        "format": "int64",
        "minimum": 1
      }
    },
    "oneOf": [
      {
        "required": [
          "personId"
        ]
      },
      {
        "required": [
          "person"
        ]
      }
    ]
  },
  "TicketPageResponse": {
    "type": "object",
    "properties": {
      "content": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Ticket"
        }
      },
      "page": {
        "type": "integer",
        "minimum": 0
      },
      "size": {
        "type": "integer",
        "minimum": 1
      },
      "totalElements": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      },
      "totalPages": {
        "type": "integer",
        "minimum": 0
      },
      "hasNext": {
        "type": "boolean"
      },
      "hasPrevious": {
        "type": "boolean"
      }
    }
  },
  "PersonPageResponse": {
    "type": "object",
    "properties": {
      "content": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Person"
        }
      },
      "page": {
        "type": "integer",
        "minimum": 0
      },
      "size": {
        "type": "integer",
        "minimum": 1
      },
      "totalElements": {
        "type": "integer",
        "format": "int64",
        "minimum": 0
      },
      "totalPages": {
        "type": "integer",
        "minimum": 0
      },
      "hasNext": {
        "type": "boolean"
      },
      "hasPrevious": {
        "type": "boolean"
      }
    }
  },
  "ErrorResponse": {
    "type": "object",
    "required": [
      "title",
      "status",
      "detail"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "status": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      },
      "detail": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
